APP_ENV=development
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/integra_sgi?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/integra_sgi?schema=public
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Local development seed only; never configure these in homolog or production.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=Integra SGI <noreply@example.test>
# Inbox that receives contact form messages; leave empty to keep the form unavailable.
CONTACT_EMAIL=
# Object storage. For local development, `docker compose up storage sync-templates` starts an S3 mock
# with the templates already uploaded; to use it from an API running outside Docker, set:
#   AWS_ACCESS_KEY_ID=local  AWS_SECRET_ACCESS_KEY=local  AWS_REGION=us-east-1
#   AWS_ENDPOINT_URL_S3=http://localhost:9090
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Bucket name inside the storage endpoint (defaults to sgi, the bucket the local S3 mock creates).
AWS_BUCKET_NAME=
# Optional: address browsers use for download links when it differs from AWS_ENDPOINT_URL_S3.
AWS_PUBLIC_ENDPOINT_URL_S3=
