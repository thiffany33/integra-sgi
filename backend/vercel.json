{
  "version": 2,
  "installCommand": "npm ci --include=dev --prefix ..",
  "buildCommand": "npm --prefix .. run build:api",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "outputDirectory": "public"
}
