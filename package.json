{
  "name": "integra-sgi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "concurrently --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @integra/web",
    "dev:api": "npm run dev --workspace @integra/api",
    "build:shared": "npm run build --workspace @integra/shared",
    "build:api": "npm run build --workspace @integra/api",
    "lint:api": "npm run lint --workspace @integra/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @integra/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @integra/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace @integra/web"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "concurrently": "^10.0.5"
  }
}
